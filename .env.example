# UpRight Now — 환경 변수 예시
# 이 파일을 .env.local 로 복사해서 사용하세요.
# secret key / service role key 는 절대 넣지 않습니다.

# 실제 웹캠 분석. 켜면 카메라 안내 화면에 `카메라 연결하기` 가 나타납니다.
VITE_ENABLE_CAMERA=false

# 실제 2인 친구 방. 켜면 방 만들기·입장이 활성화됩니다.
VITE_ENABLE_FRIEND_ROOM=false

# 친구 방을 켠 뒤에만 의미가 있습니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ENABLE_REALTIME=false

VITE_ENABLE_PIP=false

# 사용자 요청형 AI 세션 회고. 클라이언트 노출만 제어합니다.
VITE_ENABLE_AI_REPORT=false

# 아래 값은 Vercel 서버 함수에서만 읽습니다. VITE_ 접두어를 붙이지 않습니다.
AI_REPORT_ENABLED=false
GEMINI_API_KEY=

# 선택: 원문 없이 모델·스키마·성공 여부·지연 시간만 관찰합니다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# QA Lab: 개발 서버에서는 기본으로 켜집니다.
# Production 빌드는 .env.production 에서 false 로 고정되어 있습니다.
# Vercel Preview 에서 열고 싶다면 Preview 환경 변수에만 true 를 넣으세요.
VITE_ENABLE_QA_LAB=true

# 캠퍼스 테마 (학교 선택 → 포인트 색·사이드바 선택색·프로필 배지·친구 방 배너·
# 결과 공유 카드 테두리·과잠 기본 색·백팩 테마·도서관/시험기간 배경)
VITE_ENABLE_CAMPUS_THEME=false

# 캠퍼스 영토전 (/campus, /campus/map, /campus/history + 대시보드 캠퍼스 카드)
VITE_ENABLE_CAMPUS_TERRITORY=false

# 캠퍼스 저장소를 Supabase 로 바꿉니다.
# supabase/campus_territory_migration.sql 을 적용한 프로젝트에서만 켜세요.
# 비워 두면 로컬 mock 저장소를 씁니다. (Preview 는 mock 으로 확인합니다)
VITE_ENABLE_CAMPUS_SUPABASE=false
