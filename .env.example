# Deskfit — 로컬 개발 기본값입니다.
# 운영(Production) 값은 Vercel 대시보드에 따로 있으며 이 파일과 다릅니다.
#
# 사용법: 이 파일을 .env.local 로 복사한 뒤 Supabase 두 줄만 채우세요.
#   cp .env.example .env.local
# secret key / service role key 는 절대 넣지 않습니다.

# ── Supabase (친구 방·캠퍼스 공용) ──────────────────────────────
# 두 값은 수현에게 개인 메시지로 요청하세요.
# 비워 두면 친구 방과 캠퍼스 라이브 저장소만 동작하지 않고, 혼자 모드는 정상입니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── 기능 스위치 (로컬은 전부 켜 두고 개발합니다) ─────────────────

# 실제 웹캠으로 자세를 감지합니다. 끄면 카메라 없이 데모로만 볼 수 있습니다.
VITE_ENABLE_CAMERA=true

# 2인 친구 방 — 방 만들기·6자리 코드 입장을 활성화합니다.
VITE_ENABLE_FRIEND_ROOM=true

# 친구 방의 실시간 동기화(Supabase Realtime). 친구 방이 켜져 있어야 의미가 있습니다.
VITE_ENABLE_REALTIME=true

# 세션 중 PIP 미니 위젯 자동 열기 (Chrome·Edge 116+).
VITE_ENABLE_PIP=true

# 캠퍼스 학교 테마 — 학교를 고르면 포인트 색·사이드바 선택색·프로필 배지·
# 친구 방 배너·결과 공유 카드 테두리·과잠 기본 색에 반영됩니다.
VITE_ENABLE_CAMPUS_THEME=true

# 캠퍼스 영토전 (/campus, /campus/map, /campus/history + 대시보드 캠퍼스 카드).
VITE_ENABLE_CAMPUS_TERRITORY=true

# 캠퍼스 저장소를 Supabase 라이브로 씁니다.
# false 로 두면 서버 없이 로컬 mock 데이터로 화면을 확인할 수 있습니다.
VITE_ENABLE_CAMPUS_SUPABASE=true

# 사용자 요청형 AI 세션 회고. 클라이언트 노출만 제어합니다.
VITE_ENABLE_AI_REPORT=false

# 아래 값은 Vercel 서버 함수에서만 읽습니다. VITE_ 접두어를 붙이지 않습니다.
AI_REPORT_ENABLED=false
GEMINI_API_KEY=

# 기상청 단기예보 — 오픈월드 창밖 날씨를 실제 예보로 굴립니다(api/weather.ts).
# 비워 두면 월드가 지금까지 쓰던 절차적 하늘을 그대로 쓰고, 창 안에서
# "지금은 진짜 예보가 아니에요" 라고 말합니다. 가짜 예보를 만들지 않습니다.
#   data.go.kr > "기상청_단기예보 ((구)_동네예보) 조회서비스" 활용신청(자동 승인)
#   > 마이페이지 > 인증키 > **일반 인증키(Decoding)** 를 그대로 넣으세요.
# 하루 10,000회입니다. 브라우저에 넣으면 안 됩니다 — CORS 도 막히고 키도 샙니다.
KMA_SERVICE_KEY=

# 선택: 원문 없이 모델·스키마·성공 여부·지연 시간만 관찰합니다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# 개발용 QA Lab(/lab) — 자세 상태 주입·타이머 가속 등 테스트 도구.
# 운영 빌드는 .env.production 에서 false 로 고정돼 있습니다.
# Vercel Preview 에서 열고 싶다면 Preview 환경 변수에만 true 를 넣으세요.
VITE_ENABLE_QA_LAB=true
