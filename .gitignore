.vercel
.env*

# 승인 에셋 원본(ZIP)과 임시 해제 폴더 — Git 추적 제외
asset-drop/
.tmp-assets/
incoming-assets/

# Vite 빌드 산출물이 public/ 로 새어 들어오는 것을 막습니다.
# public/ 은 그대로 dist/ 로 복사되므로, 여기 남은 번들은 배포마다 함께 나갑니다.
public/assets/*.js
public/assets/*.css

# 프로토타입 단독 시연본은 빌드 산출물입니다. 원본은 index.html 입니다.
prototypes/**/standalone.html
prototypes/**/artifact.html

# 세션 중 만든 임시 검증 스크립트
_*.mjs

# 점검 스크립트가 남기는 것. 기준 그림은 커밋하고(회귀를 잡는 근거),
# 달라졌을 때 새로 찍히는 .new.png 만 뺍니다.
scripts/__shots__/*.new.png

# 디자인 캔버스의 **내보내기 판**만 뺍니다.
#
# deskfit-main-screens.html 은 옆에 있는 .dc.html 전부를 제 안에 다시 담은
# 7MB 짜리 한 파일입니다 — 같은 것이 두 벌이고, 한쪽만 고치면 어느 쪽이
# 맞는지 알 수 없어집니다. 아트보드 원본과 빌드 스크립트는 추적합니다.
design-canvas/deskfit-main-screens.html
design-canvas/preview.html
design-canvas/.fontcache/

# 대학 상표 이미지 — 시연용으로 이 기기에만 둡니다
prototypes/deskfit/assets/logo-*
prototypes/landing/assets/univ/gachon.png
prototypes/landing/assets/univ/hanyang.png
prototypes/landing/assets/univ/myongji.png

# Supabase CLI 캐시 — 실행할 때마다 다시 만듭니다
supabase/.temp/
