{
  "name": "upright-now",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/copy-prototypes.mjs",
    "typecheck": "tsc -p tsconfig.api.json --noEmit",
    "lint": "oxlint",
    "test": "node --test scripts/*.test.mjs prototypes/shared/*.test.mjs",
    "check:home": "node scripts/check-home.mjs",
    "ai:eval": "promptfoo eval -c promptfoo/ai-report.yaml",
    "ai:eval:fixtures": "promptfoo eval -c promptfoo/ai-report-fixture.yaml --no-write --no-table",
    "assets:build": "node scripts/convert-characters.mjs",
    "assets:import": "node tools/import-approved-assets.mjs",
    "assets:verify": "node tools/verify-approved-assets.mjs",
    "assets:reactions": "node scripts/convert-reactions.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@langfuse/client": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@genkit-ai/google-genai": "^1.40.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "adm-zip": "^0.6.0",
    "genkit": "^1.40.1",
    "oxlint": "^1.75.0",
    "promptfoo": "^0.121.19",
    "sharp": "^0.35.3",
    "typescript": "5.9.3"
  }
}
